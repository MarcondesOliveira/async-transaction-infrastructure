aws_region         = "us-east-1"
github_owner       = "YOUR_GITHUB_LOGIN"
project_name       = "async-transaction-processing"
environment        = "dev"
monthly_budget_usd = 5

# Enable final-teardown IAM only at the explicitly owner-approved final stage.
enable_destroy_role = false

# Query each application's actions/oidc/customization/sub endpoint before publishing.
# Copy its immutable sub_claim_prefix into this map in ignored terraform.tfvars.
# Example shape: { "example-service" = "repo:example-owner@123/example-service@456" }
# Unmapped repositories retain the legacy name-based format pending verification.
github_application_oidc_subject_prefixes = {}
github_infrastructure_oidc_subject_prefix = null

# Set this before the first apply. Leaving it null intentionally skips the budget.
budget_alert_email = null

# Routine CI can manage these existing resources, not create new API Gateway APIs.
# Copy real identifiers from the reviewed stack outputs/state into ignored tfvars.
deployment_http_api_ids             = []
deployment_rest_api_ids             = []
deployment_event_source_mapping_ids = []
